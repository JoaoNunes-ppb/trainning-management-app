# ============================================
# Athlete Management App — Environment Config
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================

# --- Database ---
POSTGRES_DB=athletedb
POSTGRES_USER=athlete
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=athletedb
DB_USER=athlete
DB_PASS=CHANGE_ME_strong_password_here

# --- JWT ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# Milliseconds. 2592000000 = 30 days (default in the prod profile)
JWT_EXPIRATION=2592000000

# --- Admin Account ---
# Credentials for the shared login account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000
