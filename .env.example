# ============================================
# Athlete Management App — Environment Config
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================

# --- Database ---
POSTGRES_DB=athletedb
POSTGRES_USER=athlete
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DB_HOST=postgres
DB_PORT=5432
DB_NAME=athletedb
DB_USER=athlete
DB_PASS=CHANGE_ME_strong_password_here

# --- JWT ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRATION=86400000

# --- Admin Account ---
# Credentials for the shared login account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional local test of AWS S3 backup profile ---
# Start with: docker compose --profile backup up -d
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=backups/athlete-manager
LOCAL_BACKUP_RETENTION_DAYS=3
TZ=Europe/Lisbon
