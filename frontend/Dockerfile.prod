FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=npm_ca,required=false \
    if [ -s /run/secrets/npm_ca ]; then npm config set cafile /run/secrets/npm_ca; fi \
    && npm ci --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2.10-alpine
ARG VCS_REF=development
COPY --from=build /app/dist /srv/frontend
COPY Caddyfile /etc/caddy/Caddyfile
LABEL org.opencontainers.image.source="https://github.com/JoaoNunes-ppb/trainning-management-app" \
      org.opencontainers.image.revision="${VCS_REF}"
EXPOSE 80 443 8081
